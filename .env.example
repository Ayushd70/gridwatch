# OpenF1 live access (MQTT + live REST). Historical data is free without this.
# Sponsor: https://buymeacoffee.com/openf1 or https://openf1.org/auth.html
# Tokens expire after 1 hour; the ingest server refreshes them automatically.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Ingest HTTP + WebSocket
INGEST_PORT=4001

# Local ingest WebSocket. Leave this unset on Vercel.
NEXT_PUBLIC_INGEST_WS=ws://localhost:4001
